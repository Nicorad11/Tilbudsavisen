# ---------------------------------------------------------------
# Tilbudsradar – miljøvariabler
# Kopiér til .env i rodmappen. Én fil til både backend og frontend
# (Vite læser kun VITE_*). Læg ALDRIG rigtige nøgler i Git.
# I produktion (NODE_ENV=production) stopper serveren med en tydelig
# fejl, hvis noget påkrævet mangler – se LAUNCH_CHECKLIST.md.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Den offentlige adresse. Bruges i links i e-mails, Stripe-redirects,
# canonical-URL'er, sitemap og scrapernes User-Agent.
# Produktion: https://tilbudsradaren.dk (påkrævet, skal være https).
APP_URL=http://localhost:5173

# Database. Tom = indlejret Postgres (PGlite) i backend/.data/pglite.
# Produktion: Postgres-URL (påkrævet). render.yaml sætter den automatisk.
# Hos en ekstern udbyder (Neon/Supabase): vælg EU-region og tilføj ?sslmode=require.
DATABASE_URL=

# Origins der må kalde API'et, kommasepareret. Kun nødvendig når frontend og
# backend ligger på forskellige domæner – i produktion serverer backend selv frontenden.
CORS_ORIGINS=http://localhost:5173

# ---------------- Login ----------------
# Tilfældig streng på mindst 32 tegn (påkrævet i produktion).
# Lav en med:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=skift-mig-til-en-lang-tilfaeldig-streng-i-produktion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# SameSite for login-cookien. "lax" når frontend og API deler domæne (standard).
# Kun "none" hvis de ligger på hvert sit domæne (kræver https).
COOKIE_SAMESITE=lax

# Brugere med disse e-mails får admin-rolle (kilde-styring, manuel scraping) og
# har altid fuld adgang uden abonnement. Påkrævet i produktion.
# Er listen tom i development, er admin-endpoints åbne (advarsel logges).
ADMIN_EMAILS=

# Morgen-tælleren på din egen PC (GET /api/stats/paying med headeren X-Stats-Token).
# Lav en lang tilfældig streng (mindst 32 tegn), fx: openssl rand -hex 32. Tom = slået fra.
STATS_TOKEN=

# ---------------- Abonnement (Stripe) ----------------
# Uden Stripe-nøglerne er betaling slået fra (også i produktion): appen virker,
# prøveperioder kører, men "Start abonnement" svarer, at betaling åbner snart.
# Kør `npm run stripe:setup` med en nøgle sat for at oprette produkt, pris,
# kundeportal og webhook – scriptet skriver værdierne herunder ud.
# Test: sk_test_… / Produktion: sk_live_… (eller en begrænset rk_live_…-nøgle).
STRIPE_SECRET_KEY=
# Signeringsnøgle til webhooken (whsec_…). Lokalt: `stripe listen --forward-to localhost:4000/api/billing/webhook`.
STRIPE_WEBHOOK_SECRET=
# Prisen på 49 kr/md inkl. moms (price_…).
STRIPE_PRICE_ID=
# Kundeportalens konfiguration (bpc_…). Tom = Stripes standardportal.
STRIPE_PORTAL_CONFIG_ID=
# Valgfri 25 % moms-sats (txr_…), så fakturaerne viser momsen. Kun når virksomheden
# er momsregistreret – opret den med `npm run stripe:setup -- --tax`.
STRIPE_TAX_RATE_ID=
# Dage med fortsat adgang efter en fejlet betaling, mens Stripe prøver igen.
PAST_DUE_GRACE_DAYS=5
# Hvornår der sendes mails om prøveperioden (påmindelse 3 dage før og ved udløb). Europe/Copenhagen.
BILLING_CRON=0 9 * * *

# ---------------- E-mail ----------------
# SMTP-URL fra e-mailudbyderen. Uden den sendes ingen e-mails (advarsel i loggen), fx
#   smtps://resend:re_xxx@smtp.resend.com:465
#   smtp://<server-token>:<server-token>@smtp.postmarkapp.com:587
# Tom i development = mails skrives i konsollen (med links), intet sendes.
SMTP_URL=
MAIL_FROM=Tilbudsradar <noreply@tilbudsradaren.dk>

# ---------------- Virksomheden ----------------
# Vises i footer, på /om, i handelsbetingelser, privatlivspolitik og i alle e-mails.
# Serveren giver dem til frontenden ved hver sidevisning – intet nyt build nødvendigt.
# Sælgerens navn og adresse skal stå på siden (e-handelsloven § 7) – også for en enkeltmand.
COMPANY_NAME=[UDFYLD: firmanavn]
# Tom = intet CVR (enkeltmand uden CVR) – så vises CVR ingen steder.
COMPANY_CVR=
COMPANY_ADDRESS=[UDFYLD: adresse]
# true, når virksomheden er momsregistreret: priserne vises "inkl. moms". Ellers står der
# kun prisen, og betingelserne siger, at der ikke lægges moms oveni.
VAT_REGISTERED=false
CONTACT_EMAIL=kontakt@tilbudsradaren.dk
# Link til Instagram-profilen (footer og /om). Tom = linket vises ikke.
VITE_INSTAGRAM_URL=[UDFYLD: https://www.instagram.com/<profil>]

# ---------------- AI: aflæsning af kvitteringer ----------------
# Uden nøgle læses kvitteringer med tekstgenkendelse (tesseract) på serveren.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max (tom = modellens standard)
ANTHROPIC_EFFORT=
# Scanninger pr. bruger pr. kalendermåned (administratorer er undtaget).
# Tokenforbruget logges pr. scanning i tabellen receipt_scans.
RECEIPT_SCANS_PER_MONTH=20
# Sprogdata til tekstgenkendelse hentes hertil første gang (~3 MB)
# OCR_CACHE_DIR=backend/.data/tessdata

# ---------------- Drift (valgfrit) ----------------
# Fejlovervågning med Sentry (vælg EU-region). Tom = slået fra.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Sentry i browseren (kan være samme projekt eller et separat frontend-projekt).
VITE_SENTRY_DSN=
# Cookiefri besøgsstatistik med Plausible (EU). Tom = slået fra.
# Kræver intet cookie-banner. UTM-parametre fra fx Instagram-links registreres automatisk.
VITE_PLAUSIBLE_DOMAIN=
# Kun hvis Plausible er selvhostet eller bruger en anden script-variant.
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# text | json (tom = json i produktion, text ellers)
LOG_FORMAT=

# ---------------- Scraping ----------------
# Tom = "Tilbudsradar/1.0 (+<APP_URL>; kontakt: <CONTACT_EMAIL>)", så kæderne kan henvende sig.
SCRAPER_USER_AGENT=
SCRAPER_MIN_DELAY_MS=1000
SCRAPER_MAX_DELAY_MS=3000
# Samlet loft pr. vært (domæne) pr. minut – gælder på tværs af alle scrapere.
SCRAPER_MAX_REQUESTS_PER_MINUTE=30
# Cron-udtryk (Europe/Copenhagen). Tom = ingen automatisk scraping.
SCRAPE_CRON=15 6,18 * * *
STORES_CRON=30 3 * * 1
# Scrape automatisk ved opstart hvis databasen er tom.
SCRAPE_ON_STARTUP=true
# Kommasepareret liste af kæde-id'er der er slået fra (feature-flag via env).
# Kan også styres fra UI'et under "Kilder".
DISABLED_CHAINS=
# Standardposition til katalog-opslag (København).
SCRAPER_DEFAULT_LAT=55.6761
SCRAPER_DEFAULT_LNG=12.5683

# Fejlnotifikationer fra scrapere (SMTP_URL og MAIL_FROM ovenfor bruges også her)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Kun hvis frontenden hostes separat fra API'et (fx Vercel + Render): fuld URL til API'et.
# VITE_API_URL=
