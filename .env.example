# ---------------------------------------------------------------
# TilbudsRadar – miljøvariabler (kopiér til .env i rodmappen)
# ---------------------------------------------------------------

# Database. Tom = indlejret Postgres (PGlite) i backend/.data/pglite.
# Sæt en rigtig Postgres-URL til produktion (Supabase, Neon, Render …).
DATABASE_URL=

PORT=4000
NODE_ENV=development

# Frontend-origin(s) der må kalde API'et, kommasepareret (kun nødvendigt
# når frontend og backend ligger på forskellige domæner).
CORS_ORIGINS=http://localhost:5173

# JWT – SKAL ændres i produktion (mindst 32 tegn).
JWT_SECRET=skift-mig-til-en-lang-tilfaeldig-streng-i-produktion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Brugere med disse e-mails får admin-rolle (kilde-styring, manuel scraping).
# Er listen tom i development, er admin-endpoints åbne (advarsel logges).
ADMIN_EMAILS=

# ---------------- Scraping ----------------
# Tydelig User-Agent med kontaktinfo, så kæderne kan henvende sig.
SCRAPER_USER_AGENT=TilbudsRadar/0.1 (+https://github.com/tilbudsradar; kontakt: tilbudsradar@example.com)
SCRAPER_MIN_DELAY_MS=1000
SCRAPER_MAX_DELAY_MS=3000
# Samlet loft pr. vært (domæne) pr. minut – gælder på tværs af alle scrapere.
SCRAPER_MAX_REQUESTS_PER_MINUTE=30
# Cron-udtryk (Europe/Copenhagen). Tom = ingen automatisk scraping.
SCRAPE_CRON=15 6,18 * * *
STORES_CRON=30 3 * * 1
# Scrape automatisk ved opstart hvis databasen er tom.
SCRAPE_ON_STARTUP=true
# Kommasepareret liste af kæde-id'er der er slået fra (feature-flag via env).
# Kan også styres fra UI'et under "Kilder".
DISABLED_CHAINS=
# Standardposition til katalog-opslag (København).
SCRAPER_DEFAULT_LAT=55.6761
SCRAPER_DEFAULT_LNG=12.5683

# Fejlnotifikationer fra scrapere
SLACK_WEBHOOK_URL=
SMTP_URL=
ALERT_EMAIL_TO=
MAIL_FROM=TilbudsRadar <noreply@tilbudsradar.local>

# ---------------- AI: aflæsning af kvitteringer ----------------
# Uden nøgle læses kvitteringer med tekstgenkendelse (tesseract) på serveren
# i stedet for af Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max (tom = modellens standard)
ANTHROPIC_EFFORT=
# Sprogdata til tekstgenkendelse hentes hertil første gang (~3 MB)
# OCR_CACHE_DIR=backend/.data/tessdata
